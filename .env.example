# ============================================================
# 环境变量示例（全部可选）
# 不配置任何 LLM 也能运行：系统默认使用规则路由 + 各领域免费 API。
# 需要 LLM 生成能力时，从下面的示例中二选一启用。
# ============================================================

# --- OpenAI（可选示例，非默认） ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-4o

# --- Anthropic（可选示例，非默认） ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- A2A API Key（可选，用于 Agent 间请求鉴权） ---
# 不设置时不校验；设置后请求需携带 X-A2A-API-Key 头。
# A2A_API_KEY=your-api-key
